{
  "manifest_version": 3,
  "name": "Studysprout Clipper",
  "version": "1.0.0",
  "description": "A basic extension of Studysprout to enhance your learning experience.",

  "permissions": [ 
    "contextMenus", 
    "storage", 
    "activeTab", 
    "scripting" 
  ],
  "host_permissions": [ "<all_urls>" ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
    }
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "externally_connectable": {
    "matches": ["http://localhost:3000/*", "https://studysprouts.in/*"]
  }
}